OPENAI_API_KEY=your-openai-or-gateway-api-key
OPENAI_API_BASE=https://your-openai-compatible-gateway/
OPENAI_MODEL=azure/genailab-maas-gpt-4o-mini
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GITHUB_TOKEN=your-github-token
OSV_API_URL=https://api.osv.dev/v1/querybatch
LOG_LEVEL=INFO
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=720
DATA_DIR=./data
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=SecureCodeGuardrailAuditor
LANGSMITH_ENDPOINT=
LANGSMITH_FINOPS_DAYS=30
LANGSMITH_FINOPS_LIMIT=200
LANGSMITH_FINOPS_CACHE_SECONDS=300

# FinOps LLM Pricing (Fallback values if LangSmith doesn't map the proxy model)
LLM_INPUT_COST_PER_MILLION=0.150
LLM_OUTPUT_COST_PER_MILLION=0.600
